{
  "rewrites": [
    { "source": "/api/qbo-status", "destination": "/api/qbo.js?action=status" },
    { "source": "/api/qbo-callback", "destination": "/api/qbo.js?action=callback" },
    { "source": "/api/qbo-disconnect", "destination": "/api/qbo.js?action=disconnect" },
    { "source": "/api/qbo-sync", "destination": "/api/qbo.js?action=sync" },
    { "source": "/api/qbo-bulk-import", "destination": "/api/qbo.js?action=bulk-import" },
    { "source": "/api/send-estimate-email", "destination": "/api/send-email.js?action=estimate" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!assets/|api/|favicon\\.svg|logo-barba\\.png|icons\\.svg|landing/|apple-touch-icon\\.png).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
